{
  "name": "@lentystyle/ssr",
  "version": "0.2.0",
  "description": "LentyStyle SSR orchestration package",
  "type": "module",
  "license": "LUIS LICENSE",
  "homepage": "https://lentystyle.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lentystyle/ssr.git"
  },
  "keywords": [
    "lentystyle",
    "luis",
    "css",
    "ssr",
    "server-side-rendering",
    "runtime",
    "html"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.min.cjs",
  "module": "./dist/index.min.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "lenty-ssr": "./dist/runner/cli.min.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.min.js",
      "require": "./dist/index.min.cjs",
      "default": "./dist/index.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.TR.md",
    "LICENSE.md",
    "LICENSE.TR.md",
    "CHANGELOG.md",
    "CHANGELOG.TR.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.TR.md",
    "CODE_OF_CONDUCT.md",
    "CODE_OF_CONDUCT.TR.md",
    "SECURITY.md",
    "SECURITY.TR.md"
  ],
  "dependencies": {
    "@lentystyle/core": "0.1.1",
    "@lentystyle/hybrid": "0.1.2"
  }
}
