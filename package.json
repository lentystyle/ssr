{
  "name": "@lentystyle/ssr",
  "version": "0.1.0",
  "description": "LentyStyle SSR orchestration package",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.min.cjs",
  "module": "./dist/index.min.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.min.js",
      "require": "./dist/index.min.cjs",
      "default": "./dist/index.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.tr.md",
    "LICENSE.md",
    "LICENSE.tr.md",
    "CHANGELOG.md",
    "CHANGELOG.tr.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.tr.md",
    "CODE_OF_CONDUCT.md",
    "CODE_OF_CONDUCT.tr.md",
    "SECURITY.md",
    "SECURITY.tr.md"
  ],
  "dependencies": {
    "@lentystyle/core": "0.1.0",
    "@lentystyle/hybrid": "0.1.0"
  }
}
